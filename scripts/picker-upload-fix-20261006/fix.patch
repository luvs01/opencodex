+    else res.end("ordinary");
+  }, { maxActiveUpstreams: 4, maxActiveUploads: 2, uploadIdleTimeoutMs: 500, uploadTimeoutMs: 2_000 });
+  const proxy = await startConnectProxy(0, { interceptPort: f.relay.port, interceptHosts: [],
+    allowedTargets: ["claude.ai:443"], selectTunnel: (_host, _port, info) => {
+      expect(isBrowserConnect(info)).toBe(true);
+      return { kind: "intercept", port: f.relay.port };
+    } });
+  const sessions: ClientHttp2Session[] = [];
+  try {
+    for (let i = 0; i < 3; i++) sessions.push(await openPickerTunnel(f, proxy.port, wait));
+    const held = [incompleteH2(sessions[0]!), incompleteH2(sessions[1]!)];
+    await wait(entered.promise);
+    expect((await wait(h2Exchange(sessions[2]!, "/ordinary").complete)).status).toBe(200);
+    expect((await wait(f.get("/ordinary"))).status).toBe(200);
+    await wait(Promise.all(held.map(upload => upload.closed)));
+    expect(f.logs.filter(line => line === "picker upload timeout")).toHaveLength(2);
+    expect((await wait(h2Exchange(sessions[0]!, "/ordinary").complete)).status).toBe(200);
+    expect((await wait(h2Exchange(sessions[1]!, "/ordinary").complete)).status).toBe(200);
+  } finally { for (const session of sessions) session.destroy(); await wait(proxy.close()); await wait(f.close()); }
+});
