+function incompleteH2(session: ClientHttp2Session, method = "POST") {
+  const stream = session.request({ ":method": method, ":path": "/upload", ":authority": "claude.ai" }, { endStream: false });
+  const closed = Promise.withResolvers<void>();
+  const response = Promise.withResolvers<number>();
+  stream.on("response", h => response.resolve(Number(h[":status"])));
+  stream.on("error", () => {}); // A stream-only reset is the expected expiry outcome.
+  stream.once("close", () => closed.resolve());
+  stream.resume();
+  stream.write("x");
+  return { stream, closed: closed.promise, response: response.promise };
+}
+
+boundedPickerTest("incomplete uploads have a separate admission budget across h2 sessions", async wait => {
+  const entered = Promise.withResolvers<void>();
+  let uploads = 0;
+  const f = await fixture((req, res) => {
+    if (req.url === "/upload") { uploads++; req.resume(); if (uploads === 2) entered.resolve(); }
+    else res.end("ordinary");
+  }, { maxActiveUpstreams: 4, maxActiveUploads: 2 });
+  const sessions = [openH2(f), openH2(f), openH2(f)];
+  try {
+    // Even GET without END_STREAM is an upload, irrespective of method or Content-Length.
+    const held = [incompleteH2(sessions[0]!), incompleteH2(sessions[1]!)];
+    await wait(entered.promise);
+    const excess = incompleteH2(sessions[2]!, "GET");
+    expect(await wait(excess.response)).toBe(503);
+    expect(uploads).toBe(2);
+    expect((await wait(f.get("/ordinary"))).status).toBe(200);
+    expect((await wait(h2Exchange(sessions[2]!, "/ordinary").complete)).status).toBe(200);
+    held[0]!.stream.close(h2Constants.NGHTTP2_CANCEL);
+    await wait(held[0]!.closed);
+  } finally { for (const session of sessions) session.destroy(); await wait(f.close()); }
+});
