+async function openPickerTunnel(f: PickerFixture, proxyPort: number, wait: DeadlineWait) {
+  const ready = Promise.withResolvers<void>();
+  const socket = netConnect({ host: "127.0.0.1", port: proxyPort }, () => {
+    socket.write("CONNECT claude.ai:443 HTTP/1.1\r\nHost: claude.ai:443\r\nUser-Agent: Mozilla/5.0 fixture\r\n\r\n");
+  });
+  let head = Buffer.alloc(0);
+  const onData = (part: Buffer) => {
+    head = Buffer.concat([head, part]);
+    const end = head.indexOf("\r\n\r\n");
+    if (end < 0) return;
+    socket.off("data", onData);
+    if (!head.toString().startsWith("HTTP/1.1 200 ")) { ready.reject(new Error("fixture CONNECT refused")); return; }
+    socket.pause();
+    if (head.length > end + 4) socket.unshift(head.subarray(end + 4));
+    ready.resolve();
+  };
+  socket.on("data", onData); socket.on("error", ready.reject);
+  try {
+    await wait(ready.promise);
+    const secure = tlsConnect({ socket, servername: "claude.ai", ca: f.ca, ALPNProtocols: ["h2"] });
+    const session = h2Connect("https://claude.ai", { createConnection: () => secure });
+    session.on("error", () => {});
+    return session;
+  } catch (error) { socket.destroy(); throw error; }
+}
